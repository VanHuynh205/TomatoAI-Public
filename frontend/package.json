{
  "name": "tomato-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=26.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "api:types": "openapi-typescript ../docs/contracts/openapi-v1.json -o src/api/schema.d.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "test:e2e": "e2e run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "e2e": "0.22.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
